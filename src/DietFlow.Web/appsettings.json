{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Site": {
    "Name": "DietFlow",
    "ContactEmail": "hello@dietflow.example",
    "ContactPhone": "+380 00 000 00 00"
  },
  "Ai": {
    "Provider": "Gemini"
  },
  "Gemini": {
    "Model": "gemini-flash-latest",
    "FallbackModel": "gemini-flash-lite-latest"
  },
  "Anthropic": {
    "Model": "claude-haiku-5-5",
    "Effort": "medium",
    "MaxTokens": 8000
  },
  "FeatureManagement": {
    "UnlimitedAiAnalysis": {
      "EnabledFor": [
        {
          "Name": "Microsoft.Targeting",
          "Parameters": {
            "Audience": {
              "Groups": [
                {
                  "Name": "Premium",
                  "RolloutPercentage": 100
                }
              ],
              "DefaultRolloutPercentage": 0
            }
          }
        }
      ]
    },
    "WeeklyMealPlan": {
      "EnabledFor": [
        {
          "Name": "Microsoft.Targeting",
          "Parameters": {
            "Audience": {
              "Groups": [
                {
                  "Name": "Premium",
                  "RolloutPercentage": 100
                }
              ],
              "DefaultRolloutPercentage": 0
            }
          }
        }
      ]
    }
  },
  "Plans": {
    "FreeDailyAnalyses": 5,
    "FreeDailyAgentMessages": 20
  },
  "Admin": {
    "Emails": []
  }
}
