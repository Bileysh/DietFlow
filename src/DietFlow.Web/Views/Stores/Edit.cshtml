@model StoreFormVm
@{
    ViewData["Title"] = $"Редагування: {Model.Name}";
}

<h1 class="h3 mb-3">Редагування магазину</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <partial name="_Form" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Зберегти</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Скасувати</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_Leaflet" />
    <script src="~/js/store-location-map.js" asp-append-version="true"></script>
}
