@using DietFlow.Web.Services
@model RecipeDetailsVm
@{
    var r = Model.Recipe;
    var s = Model.Summary;
    ViewData["Title"] = r.Title;
    ViewData["Height"] = "320px";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Рецепти</a></li>
        <li class="breadcrumb-item active">@r.Title</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <partial name="_Photo" model="r" view-data="ViewData" />
            <div class="card-body">
                <div class="small text-muted">@CookingMethodText.Icon(r.Method) @CookingMethodText.Name(r.Method) · @r.CookTimeMinutes хв · порцій: @r.Servings</div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-start">
            <h1 class="h3">@r.Title</h1>
            <div class="text-nowrap">
                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Змінити</a>
                <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
            </div>
        </div>
        @if (r.Description is not null)
        {
            <p class="lead fs-6">@r.Description</p>
        }

        @if (s is not null)
        {
            <div class="row g-2 text-center mb-3">
                @foreach (var (label, value) in new[] { ("ккал", s.Kcal.ToString("0")), ("білки, г", s.Protein.ToString("0.#")), ("жири, г", s.Fat.ToString("0.#")), ("вуглеводи, г", s.Carbs.ToString("0.#")) })
                {
                    <div class="col-3"><div class="border rounded py-2"><div class="fs-5 fw-semibold">@value</div><div class="small text-muted">@label</div></div></div>
                }
            </div>
            <p class="mb-1">
                Вартість порції (@Model.CityName):
                @if (s.Cost is { } cost)
                {
                    <strong>≈ @cost.ToString("0.00") грн</strong>
                }
                else
                {
                    <span class="text-muted">немає цін</span>
                }
            </p>
            @if (!s.CostIsComplete)
            {
                <div class="alert alert-warning py-2 small">Ціна неповна — у магазинах міста немає: @string.Join(", ", s.MissingPrices)</div>
            }

            <h2 class="h5 mt-4">Інгредієнти (на всі порції)</h2>
            <table class="table table-sm align-middle">
                <thead><tr><th>Продукт</th><th class="text-end">г</th><th class="text-end">ккал</th><th>Найдешевше</th><th class="text-end">грн</th></tr></thead>
                <tbody>
                @foreach (var line in s.Lines)
                {
                    <tr>
                        <td><a asp-controller="Products" asp-action="Details" asp-route-id="@line.ProductId">@line.ProductName</a></td>
                        <td class="text-end">@line.Grams.ToString("0")</td>
                        <td class="text-end">@line.Kcal.ToString("0")</td>
                        <td class="small">
                            @if (line.CheapestStoreId is { } storeId)
                            {
                                <a asp-controller="Stores" asp-action="Details" asp-route-id="@storeId">@line.CheapestStore</a>
                                <span class="text-muted">(@line.PricePerKg?.ToString("0.00") грн/кг)</span>
                            }
                            else
                            {
                                <span class="text-muted">немає в продажу</span>
                            }
                        </td>
                        <td class="text-end">@line.Cost?.ToString("0.00")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

@if (r.StepsMarkdown is not null)
{
    <h2 class="h5 mt-4">Приготування</h2>
    <div class="recipe-steps">@MarkdownRenderer.ToHtml(r.StepsMarkdown)</div>
}
