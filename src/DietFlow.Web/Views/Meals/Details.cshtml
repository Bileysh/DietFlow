@using DietFlow.Web.Services
@model MealDetailsVm
@{
    var m = Model.Meal;
    var a = Model.Analysis;
    ViewData["Title"] = m.DishName ?? "Прийом їжі";
    string ScoreClass(int s) => s >= 7 ? "text-bg-success" : s >= 5 ? "text-bg-warning" : "text-bg-danger";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Щоденник</a></li>
        <li class="breadcrumb-item active">@(m.DishName ?? "Прийом їжі")</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-md-5">
        @if (m.PhotoPath is not null)
        {
            <img src="@m.PhotoPath" alt="@m.DishName" class="img-fluid rounded shadow-sm" />
        }
        else
        {
            <div class="rounded bg-light d-flex align-items-center justify-content-center text-muted" style="height:240px">Фото немає</div>
        }

        @if (m.PhotoPath is not null)
        {
            <form asp-action="Analyze" asp-route-id="@m.Id" method="post" class="mt-3 ai-form">
                <button type="submit" class="btn btn-outline-primary w-100" disabled="@(!Model.AiAvailable)">
                    <span class="spinner-border spinner-border-sm d-none me-1" aria-hidden="true"></span>
                    <span class="label">@(a is null ? "🤖 Проаналізувати фото" : "🔄 Проаналізувати ще раз")</span>
                </button>
                @if (!Model.AiAvailable)
                {
                    <div class="form-text">AI-аналіз вимкнено: не налаштовано ключ AI-провайдера.</div>
                }
            </form>
        }
    </div>

    <div class="col-md-7">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h1 class="h3 mb-1">@(m.DishName ?? "Без назви")</h1>
                <div class="text-muted">@MealTypeText.Name(m.Type) · @AppTime.ToLocal(m.EatenAt).ToString("d MMMM yyyy, HH:mm")</div>
            </div>
            <div class="text-nowrap">
                <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary">Змінити</a>
                <a asp-action="Delete" asp-route-id="@m.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
            </div>
        </div>

        @if (a is { IsFood: false })
        {
            <div class="alert alert-warning mt-3">🤔 Схоже, на фото не їжа. @a.Verdict</div>
        }
        else
        {
            <div class="row g-2 text-center my-3">
                @foreach (var (label, value) in new[] { ("ккал", m.Kcal?.ToString()), ("білки, г", m.ProteinG?.ToString("0.#")), ("жири, г", m.FatG?.ToString("0.#")), ("вуглеводи, г", m.CarbsG?.ToString("0.#")) })
                {
                    <div class="col-3"><div class="border rounded py-2"><div class="fs-5 fw-semibold">@(value ?? "—")</div><div class="small text-muted">@label</div></div></div>
                }
            </div>

            @if (m.HealthScore is { } score)
            {
                <p class="mb-2">
                    Оцінка корисності: <span class="badge fs-6 @ScoreClass(score)">@score / 10</span>
                    @if (a is not null)
                    {
                        var conf = a.Confidence switch { "high" => "висока", "medium" => "середня", _ => "низька" };
                        <span class="small text-muted ms-2">впевненість AI: @conf</span>
                    }
                </p>
            }
            @if (m.Verdict is not null)
            {
                <p class="lead fs-6">@m.Verdict</p>
            }

            @if (a is not null)
            {
                <div class="row g-3">
                    @if (a.Issues.Count > 0)
                    {
                        <div class="col-md-6">
                            <h2 class="h6">⚠️ Що не так</h2>
                            <ul class="small mb-0">@foreach (var i in a.Issues) { <li>@i</li> }</ul>
                        </div>
                    }
                    @if (a.Improvements.Count > 0)
                    {
                        <div class="col-md-6">
                            <h2 class="h6">💡 Як покращити</h2>
                            <ul class="small mb-0">@foreach (var i in a.Improvements) { <li>@i</li> }</ul>
                        </div>
                    }
                </div>

                @if (a.Ingredients.Count > 0)
                {
                    <details class="mt-3">
                        <summary class="small text-muted">Що AI розпізнав на фото (@a.Ingredients.Count)</summary>
                        <ul class="small mt-2">@foreach (var ing in a.Ingredients) { <li>@ing.Name — ~@ing.Grams.ToString("0") г</li> }</ul>
                    </details>
                }
                <p class="small text-muted mt-2 mb-0">Калорії оцінено за фото — це наближення, похибка може сягати 20–30%.</p>
            }
        }
    </div>
</div>

@if (Model.Recommendations.Count > 0)
{
    <h2 class="h5 mt-5">Краща альтернатива <span class="text-muted fs-6">(ціни — @Model.CityName)</span></h2>
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var rec in Model.Recommendations)
        {
            var s = rec.Summary;
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@rec.Recipe.Id">
                        <partial name="~/Views/Recipes/_Photo.cshtml" model="rec.Recipe" />
                    </a>
                    <div class="card-body">
                        <h3 class="h6"><a asp-controller="Recipes" asp-action="Details" asp-route-id="@rec.Recipe.Id" class="text-decoration-none">@rec.Recipe.Title</a></h3>
                        <p class="small mb-2">@rec.Reason</p>
                        @if (s is not null)
                        {
                            <div class="d-flex justify-content-between small">
                                <span>
                                    <strong>@s.Kcal.ToString("0")</strong> ккал
                                    @if (m.Kcal is { } mk && s.Kcal < mk)
                                    {
                                        <span class="text-success">(−@((mk - s.Kcal).ToString("0")))</span>
                                    }
                                </span>
                                <span>@(s.Cost is { } c ? $"≈ {c:0.00} грн" : "")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/js/ai-form.js" asp-append-version="true"></script>
}
