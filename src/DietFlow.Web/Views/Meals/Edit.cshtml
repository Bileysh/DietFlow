@model MealFormVm
@{
    ViewData["Title"] = "Редагування прийому їжі";
}

<h1 class="h3 mb-3">Редагування прийому їжі</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <partial name="_Form" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Зберегти</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Скасувати</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
