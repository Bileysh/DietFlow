@using DietFlow.Web.Services
@model List<DiaryDayVm>
@{
    ViewData["Title"] = "Щоденник харчування";
    var page = (int)ViewBag.Page;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Щоденник</h1>
    <a asp-action="Create" class="btn btn-primary">+ Прийом їжі</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">За цей тиждень записів немає.</p>
}

@foreach (var day in Model)
{
    var percent = day.Goal > 0 ? (int)Math.Round(day.TotalKcal * 100.0 / day.Goal) : 0;
    var barClass = percent > 110 ? "bg-danger" : percent >= 90 ? "bg-warning" : "bg-success";
    <section class="card mb-3 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@day.Date.ToString("dddd, d MMMM")</strong>
            <span>@day.TotalKcal / @day.Goal ккал</span>
        </div>
        <div class="progress rounded-0" style="height:6px" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-bar @barClass" style="width:@Math.Min(percent, 100)%"></div>
        </div>
        <ul class="list-group list-group-flush">
            @foreach (var m in day.Meals)
            {
                <li class="list-group-item d-flex align-items-center gap-3">
                    @if (m.PhotoPath is not null)
                    {
                        <img src="@m.PhotoPath" alt="" class="rounded object-fit-cover" style="width:56px;height:56px" loading="lazy" />
                    }
                    else
                    {
                        <div class="rounded bg-light d-flex align-items-center justify-content-center text-muted" style="width:56px;height:56px">🍽️</div>
                    }
                    <div class="flex-grow-1">
                        <a asp-action="Details" asp-route-id="@m.Id" class="fw-semibold text-decoration-none">@(m.DishName ?? "Без назви")</a>
                        <div class="small text-muted">@MealTypeText.Name(m.Type) · @AppTime.ToLocal(m.EatenAt).ToString("HH:mm")</div>
                    </div>
                    @if (m.HealthScore is { } score)
                    {
                        <span class="badge @(score >= 7 ? "text-bg-success" : score >= 5 ? "text-bg-warning" : "text-bg-danger")" title="Оцінка корисності">@score/10</span>
                    }
                    <span class="text-nowrap">@(m.Kcal?.ToString() ?? "—") ккал</span>
                </li>
            }
        </ul>
    </section>
}

<nav class="d-flex justify-content-between">
    @if (ViewBag.HasOlder)
    {
        <a asp-action="Index" asp-route-page="@(page + 1)" class="btn btn-outline-secondary">← Попередній тиждень</a>
    }
    else { <span></span> }
    @if (page > 1)
    {
        <a asp-action="Index" asp-route-page="@(page - 1)" class="btn btn-outline-secondary">Наступний тиждень →</a>
    }
</nav>
