        {
          "name": "List recipes sorted by cost",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/recipes?cityId={{cityId}}&sort=cost&limit=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));pm.test(\"Paged shape\", () => {",
