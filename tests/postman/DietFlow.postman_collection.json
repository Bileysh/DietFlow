            "url": "{{baseUrl}}/api/v1/products/{{productId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman test product {{$timestamp}}\",\n  \"category\": \"Інше\",\n  \"kcalPer100g\": 300,\n  \"proteinPer100g\": 10,\n  \"fatPer100g\": 5,\n  \"carbsPer100g\": 40,\n  \"barcode\": \"{{barcode}}\"\n}"
